import hashlib
import random

rainbowTable = {}

chainCount = 0
k = 100
i = 0

def H(message):
  m = hashlib.md5()
  m.update(message.encode("utf-8"))
  return(m.hexdigest())

def R(message):
  return(message[0:6])

def gen():
  genCount = 1
  m = ""
  while genCount < 440:
    m = str(m + str(random.randint(0,1)))
    genCount += 1
  return str(m)

while chainCount < 100:
  value = gen()
  message = value
  while i < k:
    message = H(message)
    message = R(message)
  rainbowTable[value] = message

print(rainbowTable)
